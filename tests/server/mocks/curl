#!/bin/bash
# MOCK_CURL_FAIL_N=k: as k primeiras chamadas falham (Kuma indisponivel, rc 7).
# MOCK_CURL_BODY: corpo devolvido no sucesso (padrao: confirmacao do Kuma).
S=${MOCK_STATE:?}; echo "curl $*" >> "$S/curl"
n=$(( $(cat "$S/curl.n" 2>/dev/null || echo 0) + 1 )); echo "$n" > "$S/curl.n"
if [ "$n" -le "${MOCK_CURL_FAIL_N:-0}" ]; then
  echo "curl: (7) Failed to connect to 127.0.0.1 port 3001: Connection refused" >&2; exit 7
fi
def='{"ok":true}'; printf '%s' "${MOCK_CURL_BODY-$def}"; exit 0
