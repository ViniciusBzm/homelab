# Copie para /opt/homelab/stacks/control/.env (fora do Git). Imagens SEMPRE com versao fixa.
# O deploy recusa "latest", tags sem numero de versao e valores vazios.
NODE_IMAGE=node:22.<x>.<y>-alpine<versao>
GATEWAY_IMAGE=nginxinc/nginx-unprivileged:<x>.<y>.<z>-alpine
# Gravado pelo homelab-control-deploy (commit curto da imagem em uso). Nao editar a mao.
CONTROL_TAG=
# Rotulo exibido no painel (sem hostname real se for publicar capturas de tela).
HL_CONTROL_LABEL=homelab
