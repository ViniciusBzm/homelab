{
  "name": "homelab-platform",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "npm run typecheck && vitest run",
    "dev": "node apps/control-web/dev.mjs",
    "schemas:export": "npm run schemas:export -w @homelab/contracts",
    "audit:prod": "npm audit --omit=dev",
    "dev:api": "npm run dev -w @homelab/control-api",
    "build": "npm run build -w @homelab/control-web",
    "e2e": "npm run build && npm run e2e -w @homelab/control-web"
  },
  "devDependencies": {
    "@types/node": "^22.20.7",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2"
  }
}
